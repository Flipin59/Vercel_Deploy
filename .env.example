# Copy to .env.local and fill in from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ (IMPLEMENTATION.md §6).
SUPABASE_SERVICE_ROLE_KEY=

# Trusted app origin; also allow /auth/callback in Supabase Auth redirect URLs.
SITE_URL=http://localhost:3000

# Optional: Google Cloud Translation key for "Translate" on forum posts (Telugu, Hindi).
# Server only. Never prefix with NEXT_PUBLIC_. Leave empty to turn translation off.
GOOGLE_TRANSLATE_API_KEY=
